rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Media Vault Rules
    match /media_vault/{docId} {
      // Allow all logged-in students to view the archive
      allow read: if request.auth != null;
      
      // Only allow the author to create or modify their own memories
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Signatures/Messages
    match /users/{userId}/signatures/{sigId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.uid == resource.data.authorId);
    }

    // Admin Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
